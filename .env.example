# Copy this file to .env and fill in the values you need.
#
#   cp .env.example .env
#
# The scanner runs with no keys at all if you use mock mode in the UI, so you
# can clone, install, and click through the whole flow before signing up for
# anything.

# ---------------------------------------------------------------------------
# SERVER ONLY -- never prefix these with VITE_
# Vite inlines every VITE_* variable into the public JavaScript bundle, so a
# secret with a VITE_ prefix is a published secret.
# ---------------------------------------------------------------------------

# --- Model provider ---
#
# How forms get scored. The UI switch chooses between the first two so a demo
# can compare a rule-based audit with an AI audit of the same form.
#
#   heuristic -- deterministic rule-based checks. Needs no model key.
#   muse      -- Muse scores the form and writes the recommendations.
#   openai    -- the original Chat Completions path. Env-only, not in the UI.
#
# This value is the DEFAULT; the UI switch overrides it per scan.
MODEL_PROVIDER=muse

# Muse API key. Required for real (non-mock) scans on the muse provider.
MODEL_API_KEY=your-muse-api-key-here

# Muse model id and reasoning budget. "max" effort spends a lot of output
# tokens on reasoning, which adds up across a multi-form scan.
# Values for effort: minimal | low | medium | max
MUSE_MODEL=muse-wonder-1.0
MUSE_REASONING_EFFORT=low

# OpenAI API key. Required for real (non-mock) scans on the openai provider.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5

# Deadline for a single model call, in milliseconds.
#
# 75s is set against measurement: eleven real analysis calls with the full
# prompt and a screenshot ran 15.9s to 50.3s, median 28.7s.
#
# Keep this comfortably below MUSE_RETRY_BUDGET_MS. If one attempt can outlast
# the whole budget, a call that times out can never be retried, because the
# first attempt overruns the budget before a second can start. The server warns
# at startup when the two are set that way.
MODEL_TIMEOUT_MS=75000

# How long to keep trying the model before falling back to rule-based scoring.
#
# `model_not_found` arrives in bursts, and spacing beats volume: 20 rapid-fire
# requests gave 6 refusals, while 24 spaced a second apart gave none. 180s is
# the smallest budget that also fits two full-length attempts (75s + 2s + 75s),
# so a timed-out call gets a second chance rather than falling straight back.
MUSE_RETRY_BUDGET_MS=180000

# Gap between attempts, in milliseconds. Spacing is what gets through a burst.
MUSE_RETRY_DELAY_MS=2000

# Hard ceiling on requests per form, which is what actually bounds a refusal
# burst: refusals return in a few hundred milliseconds, so they barely consume
# the time budget. 180s at a 2s gap would otherwise allow about 85 requests.
MUSE_MAX_ATTEMPTS=30

# Send each form's screenshot with its HTML, so the model can judge what the
# markup cannot show: whether a label really sits beside its control, whether
# the visual order matches the DOM. Costs roughly 250 extra prompt tokens per
# form. Set to false to analyse from HTML alone.
MODEL_VISION=true

# Screenshots larger than this are skipped rather than sent, so one enormous
# capture cannot blow up a request. Bytes.
MODEL_MAX_IMAGE_BYTES=4194304

# How much of a form's HTML goes into the prompt. A form is truncated at this
# many characters and the prompt says so, so the model scores what it can see
# rather than guessing at the rest.
MODEL_HTML_CHAR_LIMIT=24000

# Ceiling on the model's own answer. The analysis is JSON with one entry per
# problem, so a form with many faults needs room to list them all.
MODEL_ANALYSIS_MAX_TOKENS=4000

# When a label is too long to serve as a name.
#
# A wrapping <label> can hold far more than a label. openai.com puts its whole
# suggestion carousel inside the one around the ChatGPT textarea, giving that
# control a genuine 1,784-character accessible name. Labels are cut to this
# length for display, the real length is kept beside them, and the analyser is
# told -- a name that long is itself the finding.
MAX_LABEL_CHARS=120

# Ask the live page what the markup cannot show: declared constraints, the
# regions waiting to announce an error, and what the browser reports when
# those constraints are checked. Without this the model is asked to score
# validation while only ever seeing an untouched form, and reads an empty
# error container as a missing one.
#
# The form is NEVER submitted and no value is typed into it. Only
# checkValidity() is called, which runs native constraint validation without
# submitting and without any network request.
PROBE_FORM_BEHAVIOUR=true

# Browserless.io token for the headless browser used to load target pages.
# Required for real scans. Free tier available at https://browserless.io
BROWSERLESS_TOKEN=your-browserless-token-here

# --- When a page counts as ready (server/lib/pageReadiness.js) ---
#
# This used to be `networkidle0`, which demands zero in-flight connections for
# 500ms. Commercial sites never go that quiet -- analytics, websockets,
# long-polls and keepalives all hold a connection open -- so navigation threw
# a timeout and the scan reported "no forms found" for a page it never read.
# Measured on united.com: networkidle0 never arrived, while domcontentloaded
# reached the same complete page in 3.4s.
#
# Values: domcontentloaded | load | networkidle2 | networkidle0
NAVIGATION_WAIT_UNTIL=domcontentloaded

# Deadline for navigation, in milliseconds. A timeout no longer discards the
# page: if anything usable rendered it is kept, and only an empty document
# fails the scan.
NAVIGATION_TIMEOUT_MS=45000

# After the document is parsed, how long to keep waiting for a field to appear.
# This is what covers client-rendered forms. Spent only on pages that have no
# fields yet, so a server-rendered form costs nothing.
FIELD_WAIT_MS=8000

# A last pause for hydration to attach to markup that has just appeared.
CONTENT_SETTLE_MS=2000

# How the scanner identifies itself.
#
# Sent by both the browser and the URL guard's pre-flight, which matters
# because the pre-flight's final URL becomes the scan target: sending nothing
# had google.com/travel/flights answer with a redirect to its
# "unsupported browser" page, which was then scanned and found to have no
# forms. Override if a site refuses this one.
# CRAWLER_USER_AGENT=

# --- Form discovery ---
#
# Find groups of fields the page never wrapped in a <form> and wrap them, so
# the HTML extractor, the geometry pass and the pairing between them all see
# the same set. Without this, a page with no form element reports zero forms:
# instagram.com/accounts/emailsignup and google.com/travel/flights both render
# their controls outside one.
#
# Set to false for a strict <form>-only reading.
INFER_FORM_GROUPS=true

# --- Screenshots and the page map (server/lib/visuals/captureFormVisuals.js) ---
#
# Caps, so one pathological page cannot exhaust memory.

# Most forms photographed on a single page, and the largest crop per form.
VISUAL_MAX_FORMS=15
VISUAL_MAX_FORM_HEIGHT=4000
VISUAL_MAX_FORM_WIDTH=2000

# Breathing room around a form in its crop, in pixels.
VISUAL_CAPTURE_PADDING=16

# The full-page map behind the clickable form outlines: JPEG quality, and the
# tallest page it will photograph.
VISUAL_PAGE_MAP_QUALITY=85
VISUAL_MAX_PAGE_MAP_HEIGHT=8000

# How tall the viewport may grow to bring a whole page into one frame. Chrome
# only paints a plain unclipped viewport screenshot correctly, so the viewport
# is made as tall as the page rather than asking for a clip.
VISUAL_MAX_CAPTURE_HEIGHT=8000

# Time for a responsive page to settle after the viewport grows.
VISUAL_REFLOW_SETTLE_MS=600

# How many times to re-measure and regrow before settling for what is there.
# Growing the viewport can itself make the page taller, because lazy sections
# render once they fall inside it: openai.com went from 5980px to 6256px the
# moment the viewport reached 5980px, carrying a form below the bottom edge of
# its own photograph.
VISUAL_MAX_GROWTH_PASSES=4

# --- Behaviour probe limits (server/lib/analysis/probeFormBehaviour.js) ---
#
# Bounds on the work PROBE_FORM_BEHAVIOUR does per page.
PROBE_MAX_FORMS=15
PROBE_MAX_FIELDS=25
PROBE_MAX_REGIONS=12

# Port and bind address for the scanner API. Keep the default loopback bind
# unless you intentionally want the (unauthenticated) server reachable.
PORT=3001
HOST=127.0.0.1

# Set to "production" to suppress internal error details in API responses.
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8080

# Maximum accepted JSON request body size.
JSON_BODY_LIMIT=100kb

# Agent throughput tier: free | basic | pro | premium. Controls inter-request
# delays and the per-scan form cap. Not a billing concept.
SCAN_TIER=premium

# How long a mock (Dev Mode) scan spends reporting progress before it completes,
# in milliseconds. The delay only paces the fake progress updates so the live
# WebSocket path behaves like a real scan. Set to 0 to complete instantly.
MOCK_SCAN_DELAY_MS=4500

# --- SSRF guard (server/middleware/urlGuard.js) ---

# Set to true ONLY to deliberately scan localhost or private-range addresses.
# Cloud metadata endpoints stay blocked regardless of this setting.
ALLOW_PRIVATE_TARGETS=false

# Maximum length of a submitted target URL.
MAX_URL_LENGTH=2048

# How many redirect hops the guard will follow; each hop is re-validated.
MAX_REDIRECTS=3

# Hard cap on how many response bytes the guard is willing to accept.
MAX_RESPONSE_BYTES=5242880

# Per-request timeout, in milliseconds, for guarded fetches.
REQUEST_TIMEOUT_MS=15000

# Timeout, in milliseconds, for DNS resolution during URL validation.
DNS_TIMEOUT_MS=5000

# Set to true to skip the redirect-following pre-flight check on submitted URLs.
SKIP_URL_PREFLIGHT=false

# --- Real scans ---
#
# Set to false to run an instance that only serves the bundled sample. A real
# target then gets 403 REAL_SCANS_DISABLED from /api/scan.
#
# Enforced by the API rather than the UI, because /api/scan is reachable
# directly and hiding a button would not prevent a scan. The browser reads
# /api/config at runtime and adapts, so this can change without rebuilding
# the front end -- a VITE_ flag could not, since Vite inlines those at build
# time.
#
# Mock (Dev Mode) scans are never gated: they read fixtures and cost nothing.
ENABLE_REAL_SCANS=true

# --- Job retention ---
#
# Jobs live in process memory. Without these they are never released, which
# on a small instance is a slow leak that ends with the process killed and
# every in-flight scan lost.
#
# The TTL applies only to finished jobs, so a long crawl is never deleted
# from under itself. MAX_JOBS is a hard ceiling that can reach past that if
# it has to -- at the ceiling, staying alive outranks any single scan.
JOB_TTL_MS=1800000
MAX_JOBS=100
JOB_SWEEP_INTERVAL_MS=60000

# Screenshot bytes are held in memory too, with their own oldest-first
# eviction. Size this against the instance: 150MB alongside Node's own
# footprint is too much for a 512MB box.
SCREENSHOT_STORE_MAX_BYTES=157286400

# --- Rate limiting ---

# General /api limiter: requests allowed per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Scan limiter. Scans spend LLM credits, so keep this tight.
SCAN_RATE_LIMIT_WINDOW_MS=300000
SCAN_RATE_LIMIT_MAX_REQUESTS=5

# Job polling limiter, and why it is separate from the general one.
#
# The UI polls /api/report while a scan runs, and a long scan is polled dozens
# of times: a 133s scan made 66 reads, which used two thirds of the general
# limit and then locked the operator out of their own running scan. Reads are
# cheap, so they get a generous allowance of their own and are exempt from the
# general limiter rather than counting against it twice.
JOB_READ_RATE_LIMIT_WINDOW_MS=900000
JOB_READ_RATE_LIMIT_MAX_REQUESTS=900

# Public endpoint limiter (health checks).
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX_REQUESTS=30

# ---------------------------------------------------------------------------
# PUBLIC -- VITE_* variables are compiled into the browser bundle.
# Treat everything below as world-readable.
# ---------------------------------------------------------------------------

# Base URL of the scanner API, as seen by the browser.
VITE_API_BASE_URL=http://localhost:3001
